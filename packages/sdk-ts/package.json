{
  "name": "@cardanowall/sdk-ts",
  "version": "0.12.0",
  "type": "module",
  "sideEffects": false,
  "description": "CardanoWall TypeScript SDK — standalone Label 309 verifier + envelope helpers + HTTP client (browser-safe).",
  "license": "Apache-2.0",
  "author": "CardanoWall <hello@cardanowall.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardanowall/label-309-ts.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://github.com/cardanowall/label-309-ts#readme",
  "bugs": {
    "url": "https://github.com/cardanowall/label-309-ts/issues"
  },
  "keywords": [
    "cardano",
    "label-309",
    "proof-of-existence",
    "poe",
    "cardanowall",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "cardanowall-sdk-conformance": "dist/conformance/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fetch": {
      "import": {
        "types": "./dist/fetch/index.d.ts",
        "default": "./dist/fetch/index.js"
      },
      "require": {
        "types": "./dist/fetch/index.d.cts",
        "default": "./dist/fetch/index.cjs"
      }
    },
    "./verifier": {
      "import": {
        "types": "./dist/verifier/index.d.ts",
        "default": "./dist/verifier/index.js"
      },
      "require": {
        "types": "./dist/verifier/index.d.cts",
        "default": "./dist/verifier/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./ids": {
      "import": {
        "types": "./dist/ids/index.d.ts",
        "default": "./dist/ids/index.js"
      },
      "require": {
        "types": "./dist/ids/index.d.cts",
        "default": "./dist/ids/index.cjs"
      }
    },
    "./merkle": {
      "import": {
        "types": "./dist/merkle/index.d.ts",
        "default": "./dist/merkle/index.js"
      },
      "require": {
        "types": "./dist/merkle/index.d.cts",
        "default": "./dist/merkle/index.cjs"
      }
    },
    "./estimate": {
      "import": {
        "types": "./dist/estimate/index.d.ts",
        "default": "./dist/estimate/index.js"
      },
      "require": {
        "types": "./dist/estimate/index.d.cts",
        "default": "./dist/estimate/index.cjs"
      }
    },
    "./certificate": {
      "import": {
        "types": "./dist/certificate/index.d.ts",
        "default": "./dist/certificate/index.js"
      },
      "require": {
        "types": "./dist/certificate/index.d.cts",
        "default": "./dist/certificate/index.cjs"
      }
    },
    "./hash": {
      "import": {
        "types": "./dist/hash/index.d.ts",
        "default": "./dist/hash/index.js"
      },
      "require": {
        "types": "./dist/hash/index.d.cts",
        "default": "./dist/hash/index.cjs"
      }
    },
    "./identity": {
      "import": {
        "types": "./dist/identity/index.d.ts",
        "default": "./dist/identity/index.js"
      },
      "require": {
        "types": "./dist/identity/index.d.cts",
        "default": "./dist/identity/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@cardanowall/crypto-core": "workspace:*",
    "@cardanowall/poe-standard": "workspace:*",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "cbor2": "^2.3.0",
    "hash-wasm": "4.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
